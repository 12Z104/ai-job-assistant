# 复制本文件为 .env，填入真实 Key
# 这个文件包含密钥，已经在 .gitignore 里，不会被提交

# ---- LLM（P4）----
LLM_API_KEY=在这里填你的DeepSeek key
LLM_BASE_URL=https://api.deepseek.com

# ---- 服务（P5）----
# 端口可覆盖，本地默认 3001；托管平台（Render 等）会动态注入
# PORT=3001
# CORS 白名单：逗号分隔的前端来源；未配置 = 本地开发放行
# FRONTEND_ORIGIN=https://your-app.vercel.app,https://preview-xxx.vercel.app

# ---- 数据库（P5 接 Supabase 后启用）----
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_KEY=service_role key（绕过 RLS，只放服务端，绝不进前端）
